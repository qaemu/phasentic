    "anisotropic_lattice_scale": false,
    "background_window_deg": 3.0,
    "background_window_points": 51,
    "candidate_dedupe": false,
    "candidate_lookup_budget": 20000,
    "candidate_pool": 300,
    "candidate_retrieval_mode": "bounded_coarse",
    "complexity_penalty": 0.1,
    "d_spacing_scale_tolerance": 0.0,
    "displacement_search_max_deg": 0.6,
    "displacement_tolerance_deg": 0.06,
    "entry_count_prior": 0.05,
