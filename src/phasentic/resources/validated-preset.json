    "lattice_scale_tolerance": 0.006,
    "matching_two_theta_max_deg": 90.0,
    "max_fit_attempts": 300,
    "max_peaks": 80,
    "max_phases": 5,
    "min_independent_evidence": 2,
    "min_objective_improvement": 0.05,
    "min_prominence_fraction": 0.01,
    "missing_intensity_max": 0.2,
    "oxidizing_synthesis": true,
    "peak_detection": "noise_aware",
    "peak_min_relative_prominence": 0.002,
    "peak_min_snr": 6.0,
    "peak_min_width_deg": 0.03,
