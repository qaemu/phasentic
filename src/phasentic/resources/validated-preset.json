    "peak_tolerance_deg": 0.1,
    "profile_eta": 0.5,
    "profile_width_deg": 0.2,
    "profile_width_mode": "estimated",
    "reference_limit": 10,
    "residual_candidate_queries": true,
    "residual_rerank": true,
    "retained_branches": 5,
    "swap_fit_attempt_budget": 25,
    "zero_shift_max_deg": 0.1,
    "zero_shift_step_deg": 0.02
  }
