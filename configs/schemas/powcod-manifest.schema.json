{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasentic.local/schemas/powcod-manifest.schema.json",
  "title": "Phasentic POW_COD manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cache_schema_version",
    "cache_index_kind",
    "cache_d_bin_width_angstrom",
    "cache_max_index_d_angstrom",
    "cache_reflection_encoding",
    "release",
    "source_url",
    "source_sha256",
    "cache_sha256",
    "phase_count",
    "line_count",
    "license",
    "attribution"
  ],
  "properties": {
    "schema_version": { "const": "powcod-manifest-1" },
    "cache_schema_version": { "const": "powcod-cache-2" },
    "cache_index_kind": { "const": "compressed-reflections-d-bin-bitset" },
    "cache_d_bin_width_angstrom": { "type": "number", "exclusiveMinimum": 0 },
    "cache_max_index_d_angstrom": { "type": "number", "exclusiveMinimum": 0 },
    "cache_reflection_encoding": { "const": "PCOL-1" },
    "release": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_path_name": { "type": ["string", "null"] },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_size": { "type": "integer", "minimum": 0 },
    "info_path_name": { "type": ["string", "null"] },
    "info_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "cache_path_name": { "type": "string", "minLength": 1 },
    "cache_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "phase_count": { "type": "integer", "minimum": 0 },
    "line_count": { "type": "integer", "minimum": 0 },
    "license": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
