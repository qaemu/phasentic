{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasentic.local/schemas/wp5-case-manifest.schema.json",
  "title": "Phasentic WP-5 case inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "status", "source_manifest_id", "created_at", "cases"],
  "properties": {
    "schema_version": {"const": "wp5-case-manifest-0.1"},
    "manifest_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["draft", "inventory", "frozen", "validated", "blocked"]},
    "source_manifest_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))(?!^[A-Za-z]:)(?!^\\.$)"
    },
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "sample_id", "scan_id", "source_ids", "raw_path", "raw_sha256",
        "data_kind", "angle_unit", "radiation", "geometry", "scan_range_deg",
        "expected_phase_groups", "uncertain_phase_groups", "label_completeness",
        "label_provenance", "family_group_ids", "split", "eligibility", "eligibility_reasons"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "kind": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "sample_id": {"$ref": "#/$defs/identifier"},
        "scan_id": {"$ref": "#/$defs/identifier"},
        "replicate_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "source_ids": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "raw_path": {"$ref": "#/$defs/relativePath"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_path": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "normalized_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "data_kind": {"enum": ["measured", "measured_negative", "synthetic", "synthetic_negative", "mixed"]},
        "angle_unit": {"const": "two_theta"},
        "radiation": {"type": "string", "minLength": 1},
        "geometry": {"const": "reflection_bragg_brentano"},
        "scan_range_deg": {
          "type": "array",
          "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "maximum": 180}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "acquisition_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "instrument_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "profile_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "calibration_artifact_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "expected_phase_groups": {"$ref": "#/$defs/stringArray"},
        "expected_parent_family_groups": {"$ref": "#/$defs/stringArray"},
        "uncertain_phase_groups": {"$ref": "#/$defs/stringArray"},
        "label_completeness": {"enum": ["complete", "incomplete", "unknown", "not_applicable"]},
        "label_provenance": {"$ref": "#/$defs/stringArray"},
        "family_group_ids": {"$ref": "#/$defs/stringArray"},
        "duplicate_group_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "parent_group_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "split": {"enum": ["development", "calibration", "test", "unassigned"]},
        "eligibility": {"enum": ["eligible", "excluded", "pending", "unavailable"]},
        "eligibility_reasons": {"$ref": "#/$defs/stringArray"},
        "strata": {"type": "object", "additionalProperties": true},
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "calibration_status": {
              "enum": ["passed", "failed", "insufficient_data", "unverified"]
            }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {"required": ["normalized_path", "normalized_sha256"]},
            {"not": {"anyOf": [{"required": ["normalized_path"]}, {"required": ["normalized_sha256"]}]}}
          ]
        },
        {
          "if": {
            "required": ["data_kind", "metadata"],
            "properties": {
              "data_kind": {"enum": ["measured", "measured_negative"]},
              "metadata": {"properties": {"calibration_status": {"const": "passed"}}}
            }
          },
          "then": {
            "required": ["calibration_artifact_id"],
            "properties": {
              "calibration_artifact_id": {"$ref": "#/$defs/identifier"}
            }
          }
        }
      ]
    }
  }
}
