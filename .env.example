# Optional overrides. By default Phasentic uses POW_COD from ~/.phasentic/powcod
# (installed by `phasentic setup-powcod`) and the demo subset otherwise.
# PHASENTIC_HOME=/absolute/path/instead/of/~/.phasentic
# PHASENTIC_REFERENCE_SOURCE=pow_cod
# PHASENTIC_POWCOD_PATH=/absolute/path/to/cod2205.sq
# PHASENTIC_POWCOD_CACHE_PATH=/absolute/path/to/powcod-2205.xrd.sqlite
# PHASENTIC_POWCOD_EQUIVALENCE_PATH=/absolute/path/to/powcod-2205.equivalence.sqlite

# Optional GSAS-II installation, used only to import binary vendor .raw files
# GSASII_PATH=/absolute/path/to/GSAS-II
